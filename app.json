{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5303925075056294~8454086880",
    "ios_app_id": "ca-app-pub-5303925075056294~4361789479"
  },
  "expo": {
    "name": "NutriVision",
    "slug": "nutri",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "NutriVision utilise la caméra pour analyser vos plats et calculer le Nutri-Score."
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5303925075056294~8454086880",
          "iosAppId": "ca-app-pub-5303925075056294~4361789479"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dialectal.nutrivision",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriVision utilise la caméra pour analyser vos plats et calculer le Nutri-Score."
      }
    },
    "android": {
      "package": "com.dialectal.nutrivisionapp",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#121826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
