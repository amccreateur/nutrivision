{
  "expo": {
    "name": "NutriVision",
    "slug": "nutri",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "NutriVision utilise la caméra pour analyser vos plats et calculer le Nutri-Score."
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dialectal.nutrivision",
      "infoPlist": {
        "NSCameraUsageDescription": "NutriVision utilise la caméra pour analyser vos plats et calculer le Nutri-Score."
      }
    },
    "android": {
      "package": "com.dialectal.nutrivisionapp",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#121826",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
